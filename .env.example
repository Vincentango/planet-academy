# PostgreSQL — docker compose 默认账号如下
DATABASE_URI=postgresql://planet:planet@localhost:5432/planet_academy

# 后台密钥，部署时必须换成足够长的随机串。不要把真实密钥提交进仓库。
PAYLOAD_SECRET=CHANGE_ME_PAYLOAD_SECRET_PLANET

# 首次启动 onInit / bun run seed 会创建管理员
ADMIN_EMAIL=admin@planetacad.one
ADMIN_PASSWORD=ChangeMe_Planet1

# Optional. When set, media uploads go to Vercel Blob.
# BLOB_READ_WRITE_TOKEN=
